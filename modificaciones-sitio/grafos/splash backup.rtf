</div>\
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script><script>\
(function() \{\
\
var root = document.querySelector('.mampa-portada');\
if (!root) return;\
\
var container = root.querySelector('#mampa-graph-panel');\
var svgEl = root.querySelector('#mampa-graph');\
var statsEl = root.querySelector('#mampa-stats');\
var detailPanel = root.querySelector('#mampa-detail-panel');\
var tooltip = root.querySelector('#mampa-tooltip');\
var loading = root.querySelector('#mampa-loading');\
var heroNodos = root.querySelector('#mampa-hero-nodos');\
var heroAristas = root.querySelector('#mampa-hero-aristas');\
\
var DATA_URL = 'http://localhost:9005/themes/PortadafreedomISEP/asset/js/data/graph.json';\
\
function initGraph(GRAPH_DATA) \{\
  var typeLabels = \{\
    authored_by: 'Autores',\
    tagged_with: 'Palabras clave',\
    belongs_to_area: '&Aacute;reas tem&aacute;ticas',\
    is_type: 'Tipo de contenido'\
  \};\
  var typeColors = \{\
    authored_by: '#00b2e3',\
    tagged_with: '#0080b1',\
    belongs_to_area: '#87c6a1',\
    is_type: '#009e96'\
  \};\
  var colorMap = \{ item: '#0080b1', creator: '#00b2e3', subject: '#87c6a1', coverage: '#0080b1', type: '#009e96' \};\
  var typeNames = \{ item: 'Ficha', creator: 'Autor/a', subject: 'Palabra clave', coverage: '&Aacute;rea', type: 'Tipo' \};\
\
  var allNodes = GRAPH_DATA.nodes.map(function(n) \{\
    return \{\
      id: n.id, label: n.l, type: n.t, color: colorMap[n.t] || n.c,\
      url: n.url || '', abstract: n.abs || '', fullTitle: n.ft || n.l,\
      publisher: n.pub || '', issued: n.dt || '',\
      educationLevel: n.el || [], degree: n.d || 0\
    \};\
  \});\
\
  var allEdges = GRAPH_DATA.edges.map(function(e) \{\
    return \{ source: e.s, target: e.t, relation: e.r \};\
  \});\
\
  var nodeMap = new Map(allNodes.map(function(n) \{ return [n.id, n]; \}));\
\
  if (heroNodos) heroNodos.textContent = allNodes.length;\
  if (heroAristas) heroAristas.textContent = allEdges.length;\
\
  function formatDate(raw) \{\
    if (!raw) return '';\
    var m = raw.match(/^(\\d\{4\})-(\\d\{2\})-(\\d\{2\})/);\
    if (m) return m[3] + '/' + m[2] + '/' + m[1];\
    return raw;\
  \}\
\
  var activeRelations = new Set(Object.keys(typeLabels));\
  var focusedNodeId = null;\
  var maxHops = 2;\
\
  var width = container.offsetWidth;\
  var height = container.offsetHeight;\
  var svg = d3.select(svgEl);\
  var g = svg.append('g');\
  var rotG = g.append('g').attr('class', 'rotation');\
  var edgeG = rotG.append('g').attr('class', 'edges');\
  var nodeG = rotG.append('g').attr('class', 'nodes');\
  var labelG = rotG.append('g').attr('class', 'labels');\
  var highlightG = rotG.append('g').attr('class', 'highlight');\
\
  var defs = svg.append('defs');\
  var glow = defs.append('filter').attr('id', 'mampa-glow').attr('x', '-50%').attr('y', '-50%').attr('width', '200%').attr('height', '200%');\
  glow.append('feGaussianBlur').attr('stdDeviation', '4').attr('result', 'blur');\
  glow.append('feComposite').attr('in', 'SourceGraphic').attr('in2', 'blur').attr('operator', 'over');\
\
  var currentScale = 1;\
  var VX = width / 2;\
  var VY = height / 2;\
  var GRAPH_SHIFT = -width * 0.10;\
  var zoom = d3.zoom()\
    .scaleExtent([0.05, 8])\
    .filter(function(event) \{ return false; \})\
    .on('zoom', function(e) \{\
      g.attr('transform', 'translate(' + GRAPH_SHIFT + ',0) ' + e.transform);\
      updateLabelsForScale(e.transform.k);\
    \});\
  svg.call(zoom);\
\
  svg.on('wheel', function(event) \{\
    event.preventDefault();\
    var dir = event.deltaY > 0 ? -1 : 1;\
    var factor = 1 + dir * 0.08;\
    var prev = currentScale;\
    currentScale = Math.max(0.05, Math.min(8, currentScale * factor));\
    var realFactor = currentScale / prev;\
    var t = d3.zoomIdentity\
      .translate(VX, VY)\
      .scale(currentScale)\
      .translate(-VX, -VY);\
    zoom.transform(svg, t);\
  \});\
\
  function updateLabelsForScale(scale) \{\
    var threshold;\
    if (scale < 0.3)      threshold = 50;\
    else if (scale < 0.6) threshold = 20;\
    else if (scale < 1)   threshold = 10;\
    else if (scale < 2)   threshold = 5;\
    else                  threshold = 0;\
    if (labelEls) \{\
      labelEls.each(function(d) \{\
        var show = d.type !== 'item' && d.degree >= threshold;\
        d3.select(this).transition().duration(150)\
          .attr('fill-opacity', show ? 0.9 : 0);\
      \});\
    \}\
  \}\
\
  var simulation = d3.forceSimulation()\
    .force('link', d3.forceLink().id(function(d) \{ return d.id; \}).distance(function(d) \{\
      var st = nodeMap.get(typeof d.source === 'string' ? d.source : d.source.id);\
      var tt = nodeMap.get(typeof d.target === 'string' ? d.target : d.target.id);\
      if (st && st.type === 'coverage' || tt && tt.type === 'coverage') return 120;\
      if (st && st.type === 'type' || tt && tt.type === 'type') return 150;\
      return 60;\
    \}))\
    .force('charge', d3.forceManyBody().strength(function(d) \{ return d.type === 'item' ? -15 : -60; \}))\
    .force('center', d3.forceCenter(width / 2, height / 2))\
    .force('collision', d3.forceCollide().radius(function(d) \{ return getRadius(d) + 2; \}))\
    .alphaDecay(0.015);\
\
  function getRadius(d) \{\
    if (d.type === 'item') return 3;\
    if (d.type === 'coverage') return Math.max(8, Math.sqrt(d.degree) * 2);\
    if (d.type === 'type') return Math.max(9, Math.sqrt(d.degree) * 1.8);\
    return Math.max(4, Math.sqrt(d.degree) * 1.4);\
  \}\
\
  function getNodeOpacity(d) \{\
    return d.type === 'item' ? 0.35 : 0.55;\
  \}\
\
  var linkEls, nodeEls, labelEls;\
  var currentNodes = [], currentEdges = [];\
  var nodeDepth = null;\
\
  function getEdgeId(e) \{\
    var sid = typeof e.source === 'string' ? e.source : e.source.id;\
    var tid = typeof e.target === 'string' ? e.target : e.target.id;\
    return sid + '|' + tid + '|' + e.relation;\
  \}\
\
  function updateGraph() \{\
    var filteredEdges = allEdges.filter(function(e) \{ return activeRelations.has(e.relation); \});\
\
    if (focusedNodeId) \{\
      var adj = new Map();\
      filteredEdges.forEach(function(e) \{\
        var sid = typeof e.source === 'string' ? e.source : e.source.id;\
        var tid = typeof e.target === 'string' ? e.target : e.target.id;\
        if (!adj.has(sid)) adj.set(sid, new Set());\
        if (!adj.has(tid)) adj.set(tid, new Set());\
        adj.get(sid).add(tid);\
        adj.get(tid).add(sid);\
      \});\
\
      nodeDepth = new Map();\
      nodeDepth.set(focusedNodeId, 0);\
      var frontier = new Set([focusedNodeId]);\
      for (var hop = 1; hop <= maxHops; hop++) \{\
        var nextFrontier = new Set();\
        frontier.forEach(function(id) \{\
          (adj.get(id) || new Set()).forEach(function(nbr) \{\
            if (!nodeDepth.has(nbr)) \{\
              nodeDepth.set(nbr, hop);\
              nextFrontier.add(nbr);\
            \}\
          \});\
        \});\
        frontier = nextFrontier;\
      \}\
\
      var neighborIds = new Set(nodeDepth.keys());\
      currentEdges = filteredEdges.filter(function(e) \{\
        var sid = typeof e.source === 'string' ? e.source : e.source.id;\
        var tid = typeof e.target === 'string' ? e.target : e.target.id;\
        return neighborIds.has(sid) && neighborIds.has(tid);\
      \});\
      currentNodes = allNodes.filter(function(n) \{ return neighborIds.has(n.id); \});\
    \} else \{\
      nodeDepth = null;\
      currentEdges = filteredEdges;\
      var connectedIds = new Set();\
      currentEdges.forEach(function(e) \{\
        connectedIds.add(typeof e.source === 'string' ? e.source : e.source.id);\
        connectedIds.add(typeof e.target === 'string' ? e.target : e.target.id);\
      \});\
      currentNodes = allNodes.filter(function(n) \{ return connectedIds.has(n.id); \});\
    \}\
\
    if (focusedNodeId) \{\
      var n = currentNodes.length;\
      var chargeStr = n < 30 ? -300 : n < 80 ? -200 : -140;\
      simulation\
        .force('charge', d3.forceManyBody().strength(chargeStr))\
        .force('collision', d3.forceCollide().radius(function(d) \{ return getRadius(d) + 8; \}))\
        .force('link', d3.forceLink().id(function(d) \{ return d.id; \}).distance(function(d) \{\
          var sid = typeof d.source === 'string' ? d.source : d.source.id;\
          var tid = typeof d.target === 'string' ? d.target : d.target.id;\
          var minD = Math.min(nodeDepth.get(sid) || maxHops, nodeDepth.get(tid) || maxHops);\
          return 100 + (minD / maxHops) * 60;\
        \}));\
    \} else \{\
      simulation\
        .force('charge', d3.forceManyBody().strength(function(d) \{ return d.type === 'item' ? -15 : -60; \}))\
        .force('collision', d3.forceCollide().radius(function(d) \{ return getRadius(d) + 2; \}))\
        .force('link', d3.forceLink().id(function(d) \{ return d.id; \}).distance(function(d) \{\
          var st = nodeMap.get(typeof d.source === 'string' ? d.source : d.source.id);\
          var tt = nodeMap.get(typeof d.target === 'string' ? d.target : d.target.id);\
          if (st && st.type === 'coverage' || tt && tt.type === 'coverage') return 120;\
          if (st && st.type === 'type' || tt && tt.type === 'type') return 150;\
          return 60;\
        \}));\
    \}\
\
    var edgeColor = '#8a9e78';\
    linkEls = edgeG.selectAll('line').data(currentEdges, getEdgeId);\
    linkEls.exit().transition().duration(300).attr('stroke-opacity', 0).remove();\
    linkEls = linkEls.enter().append('line')\
      .attr('stroke', edgeColor)\
      .attr('stroke-opacity', 0)\
      .attr('stroke-width', focusedNodeId ? 1 : 0.5)\
      .merge(linkEls);\
    linkEls.transition().duration(400)\
      .attr('stroke', edgeColor)\
      .attr('stroke-opacity', function(d) \{\
        if (!focusedNodeId || !nodeDepth) return 0.18;\
        var sid = typeof d.source === 'string' ? d.source : d.source.id;\
        var tid = typeof d.target === 'string' ? d.target : d.target.id;\
        var minDepth = Math.min(nodeDepth.get(sid) || maxHops, nodeDepth.get(tid) || maxHops);\
        return 0.4 - (minDepth / maxHops) * 0.25;\
      \})\
      .attr('stroke-width', function(d) \{\
        if (!focusedNodeId || !nodeDepth) return 0.5;\
        var sid = typeof d.source === 'string' ? d.source : d.source.id;\
        var tid = typeof d.target === 'string' ? d.target : d.target.id;\
        var minDepth = Math.min(nodeDepth.get(sid) || maxHops, nodeDepth.get(tid) || maxHops);\
        return 1.2 - (minDepth / maxHops) * 0.6;\
      \});\
\
    nodeEls = nodeG.selectAll('circle').data(currentNodes, function(d) \{ return d.id; \});\
    nodeEls.exit().transition().duration(300).attr('r', 0).remove();\
    var entered = nodeEls.enter().append('circle')\
      .attr('r', 0)\
      .attr('fill', function(d) \{ return d.color; \})\
      .attr('stroke', 'none')\
      .attr('cursor', 'default');\
    nodeEls = entered.merge(nodeEls);\
    nodeEls.transition().duration(400)\
      .attr('r', function(d) \{ return getRadius(d); \})\
      .attr('fill', function(d) \{ return d.color; \})\
      .attr('opacity', function(d) \{ return getNodeOpacity(d); \});\
\
    var labelNodes = currentNodes.filter(function(n) \{ return n.type !== 'item'; \});\
    labelEls = labelG.selectAll('text').data(labelNodes, function(d) \{ return d.id; \});\
    labelEls.exit().transition().duration(200).attr('fill-opacity', 0).remove();\
    labelEls = labelEls.enter().append('text')\
      .attr('font-size', function(d) \{ return focusedNodeId ? 11 : (d.type === 'coverage' ? 11 : 9); \})\
      .attr('fill', function(d) \{ return d.id === focusedNodeId ? '#3a3428' : d.color; \})\
      .attr('fill-opacity', 0)\
      .attr('text-anchor', 'middle')\
      .attr('dy', function(d) \{ return -getRadius(d) - 5; \})\
      .attr('font-family', "Raleway, sans-serif")\
      .attr('font-weight', function(d) \{ return d.id === focusedNodeId ? 700 : 400; \})\
      .attr('font-style', function(d) \{ return d.id === focusedNodeId ? 'normal' : 'italic'; \})\
      .attr('pointer-events', 'none')\
      .text(function(d) \{\
        var max = d.id === focusedNodeId ? 50 : 30;\
        return d.label.length > max ? d.label.slice(0, max - 3) + '...' : d.label;\
      \})\
      .merge(labelEls);\
    labelEls.transition().duration(400)\
      .attr('fill', function(d) \{ return d.id === focusedNodeId ? '#3a3428' : d.color; \})\
      .attr('font-weight', function(d) \{ return d.id === focusedNodeId ? 700 : 400; \})\
      .attr('fill-opacity', function(d) \{\
        if (d.id === focusedNodeId) return 1;\
        return 0;\
      \})\
      .attr('font-size', function(d) \{\
        if (!focusedNodeId || !nodeDepth) return d.type === 'coverage' ? 11 : 9;\
        var depth = nodeDepth.get(d.id) || maxHops;\
        return Math.round(13 - (depth / maxHops) * 4);\
      \})\
      .attr('dy', function(d) \{ return -getRadius(d) - 5; \});\
\
    highlightG.selectAll('*').remove();\
    if (focusedNodeId) \{\
      var fn = currentNodes.find(function(n) \{ return n.id === focusedNodeId; \});\
      if (fn) \{\
        var r = getRadius(fn);\
        var outer = highlightG.append('circle')\
          .attr('r', r + 12)\
          .attr('fill', 'none')\
          .attr('stroke', fn.color)\
          .attr('stroke-width', 1.5);\
        outer.append('animate')\
          .attr('attributeName', 'stroke-opacity')\
          .attr('values', '0.6;0.1;0.6')\
          .attr('dur', '2s')\
          .attr('repeatCount', 'indefinite');\
        outer.append('animate')\
          .attr('attributeName', 'r')\
          .attr('values', (r + 8) + ';' + (r + 20) + ';' + (r + 8))\
          .attr('dur', '2s')\
          .attr('repeatCount', 'indefinite');\
        highlightG.append('circle')\
          .attr('r', r + 4)\
          .attr('fill', 'none')\
          .attr('stroke', fn.color)\
          .attr('stroke-width', 2)\
          .attr('stroke-opacity', 0.6)\
          .attr('filter', 'url(#mampa-glow)');\
      \}\
    \}\
\
    simulation.nodes(currentNodes);\
    simulation.force('link').links(currentEdges);\
    simulation.force('center', d3.forceCenter(width / 2, height / 2));\
    simulation.alpha(0.8).restart();\
\
    var label = focusedNodeId ? ' (vecindario ' + maxHops + (maxHops === 1 ? ' salto' : ' saltos') + ')' : '';\
    if (statsEl) statsEl.textContent = currentNodes.length + ' nodos &middot; ' + currentEdges.length + ' aristas' + label;\
  \}\
\
  simulation.on('tick', function() \{\
    if (linkEls) linkEls\
      .attr('x1', function(d) \{ return d.source.x; \}).attr('y1', function(d) \{ return d.source.y; \})\
      .attr('x2', function(d) \{ return d.target.x; \}).attr('y2', function(d) \{ return d.target.y; \});\
    if (nodeEls) nodeEls\
      .attr('cx', function(d) \{ return d.x; \}).attr('cy', function(d) \{ return d.y; \});\
    if (labelEls) labelEls\
      .attr('x', function(d) \{ return d.x; \}).attr('y', function(d) \{ return d.y; \});\
    if (focusedNodeId) \{\
      var fn = currentNodes.find(function(n) \{ return n.id === focusedNodeId; \});\
      if (fn) highlightG.selectAll('circle').attr('cx', fn.x).attr('cy', fn.y);\
    \}\
  \});\
\
  updateGraph();\
\
  currentScale = 0.75;\
  var initT = d3.zoomIdentity.translate(VX, VY).scale(currentScale).translate(-VX, -VY);\
  svg.call(zoom.transform, initT);\
  g.attr('transform', 'translate(' + GRAPH_SHIFT + ',0) ' + initT);\
  updateLabelsForScale(currentScale);\
\
  simulation.alphaTarget(0.08).alphaDecay(0.01);\
\
  var rotAngle = 0;\
  var rotRaf = null;\
  var ROT_SPEED = 0.035;\
  var ROTATION_START_DELAY = 10000;\
  var initTime = Date.now();\
\
  function rotateGraph() \{\
    if (Date.now() - initTime < ROTATION_START_DELAY) \{\
      rotRaf = requestAnimationFrame(rotateGraph);\
      return;\
    \}\
    rotAngle = (rotAngle + ROT_SPEED) % 360;\
    rotG.attr('transform', 'rotate(' + rotAngle + ',' + (width/2) + ',' + (height/2) + ')');\
    rotRaf = requestAnimationFrame(rotateGraph);\
  \}\
  rotRaf = requestAnimationFrame(rotateGraph);\
\}\
\
fetch(DATA_URL)\
  .then(function(r) \{ return r.json(); \})\
  .then(function(data) \{\
    if (loading) loading.remove();\
    initGraph(data);\
  \})\
  .catch(function(err) \{\
    if (loading) loading.textContent = 'Error al cargar datos: ' + err.message;\
  \});\
\
\})();\
</script>}